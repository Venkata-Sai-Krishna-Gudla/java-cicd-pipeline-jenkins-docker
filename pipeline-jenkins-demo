pipeline {
    agent any

    stages {

        stage('Clone GitHub Repository') {
            steps {
                git branch: 'main',
                    changelog: false,
                    poll: false,
                    url: 'https://github.com/theshubhamgour/jenkins-tutorial.git'

                sh 'pwd'
            }
        }

        stage('Build') {
            steps {
                dir('3-java-jenkins-docker-app') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Test') {
            steps {
                dir('3-java-jenkins-docker-app') {
                    sh 'mvn test'
                }
            }
        }

        stage('Compile') {
            steps {
                dir('3-java-jenkins-docker-app') {
                    sh 'mvn compile'
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('3-java-jenkins-docker-app') {
                    sh 'docker build -t java-jenkins-docker:latest .'
                }
            }
        }

        stage('Docker Image Tag') {
            steps {
                sh 'docker tag java-jenkins-docker:latest krishnakumargv/java-jenkins-docker:latest'
            }
        }

        stage('Docker Login') {
            steps {
                echo 'Docker Hub credentials configured in Jenkins Credentials Manager'
            }
        }

        stage('Docker Image Push') {
            steps {
                sh 'docker push krishnakumargv/java-jenkins-docker:latest'
            }
        }
    }
}